{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": false,
        "outDir": "dist",
        "sourceMap": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "exactOptionalPropertyTypes": false,
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["@types/node"],
        "skipLibCheck": true,
        "incremental": true,
        "tsBuildInfoFile": "./.tsbuildinfo",
        "paths": {}
    },
    "include": ["src/**/*", "tests/**/*", "scripts/**/*", "playwright.config.ts", "playwright.config.integration.ts", "playwright.config.remote.ts", "vitest.config.ts", "src/types/cloudflare-stubs.d.ts", "src/types/cloudflare-workers.d.ts"],
    "exclude": ["node_modules", "dist"]
}
