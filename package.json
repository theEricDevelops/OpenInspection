{
  "name": "openinspection",
  "version": "1.0.0-rc.1",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/InspectorHub/OpenInspection.git"
  },
  "homepage": "https://inspectorhub.io",
  "bugs": {
    "url": "https://github.com/InspectorHub/OpenInspection/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"tsx watch src/server.ts\" \"npx tailwindcss -i ./src/styles/input.css -o ./public/styles.css --watch\"",
    "start": "node --import tsx src/server.ts",
    "vendor:copy": "node scripts/vendor-copy.js",
    "build": "npm run vendor:copy && npm run css:build && tsc",
    "gen-version": "node scripts/gen-version.js",
    "deploy": "echo 'Use your own deployment method (rsync, docker, etc.). See docs/deploy.md'",
    "css:build": "npx tailwindcss -i ./src/styles/input.css -o ./public/styles.css --minify",
    "css:watch": "npx tailwindcss -i ./src/styles/input.css -o ./public/styles.css --watch",
    "type-check": "npx -p typescript tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security-scan": "npm audit --audit-level=high",
    "test:unit": "vitest run --config vitest.config.ts",
    "seed:comments": "node scripts/seed-comments.js",
    "seed:recommendations": "node scripts/seed-recommendations.js",
    "seed:rating-systems": "node scripts/seed-rating-systems.js",
    "seed:marketplace": "node scripts/seed-marketplace.js",
    "seed:sandbox": "node scripts/sandbox-seed.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@hono/node-server": "^2.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node-cron": "^3.0.11",
    "better-sqlite3": "^12.10.0",
    "dexie": "^4.0.10",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "hono": "^4.12.18",
    "ioredis": "^5.10.1",
    "nanoid": "^5.1.11",
    "node-cron": "^4.2.1",
    "node-diff3": "^3.1.2",
    "otpauth": "^9.5.1",
    "puppeteer": "^25.0.4",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.15.11",
    "@eslint/js": "^9.39.4",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hono/zod-openapi": "^1.2.4",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "alpinejs": "^3.15.11",
    "chart.js": "^4.5.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "fake-indexeddb": "^6.0.0",
    "flatpickr": "^4.6.13",
    "globals": "^17.4.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "konva": "^10.2.5",
    "lint-staged": "^16.4.0",
    "quill": "^2.0.3",
    "sortablejs": "^1.15.7",
    "swagger-ui-dist": "^5.32.5",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
